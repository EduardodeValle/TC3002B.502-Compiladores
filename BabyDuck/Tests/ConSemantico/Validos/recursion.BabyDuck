programa test4;
vars
    res : entero;

entero fib(n: entero) {
    vars
        aux : entero;
    {
        si (n < 2) {
            devolver n;
        } sino {
            devolver fib(n - 1) + fib(n - 2);
        };
    }
};

inicio
    {
        res = fib(6);
        escribe("Fibonacci de 6 es:");
        escribe(res);
    }
fin
